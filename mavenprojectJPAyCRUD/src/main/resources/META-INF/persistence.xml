<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" 
             xmlns="https://jakarta.ee/xml/ns/persistence" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence 
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
             
             
             <!--CREATE USER 'clientes'@localhost IDENTIFIED BY '12345678';
             GRANT ALL privileges ON `salacine`.* TO 'clientes'@localhost IDENTIFIED BY '12345678';-->
	<persistence-unit name="salacineUP" transaction-type="RESOURCE_LOCAL">
		<properties>
			<property name="javax.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/salacine"/>
			<property name="javax.persistence.jdbc.user" value="clientes"/>
			<property name="javax.persistence.jdbc.password" value="12345678"/>
			<property name="javax.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>
			
			<property name="hibernate.dialect" value="org.hibernate.dialect.MariaDB102Dialect"/>
			<property name="hibernate.connection.driver_class" value="org.mariadb.jdbc.Driver"/>
			<property name="hibernate.show_sql" value="true"/> <!--Mostrara todo lo que se haga con query-->
			<property name="hibernate.format_sql" value="true"/>
			<!--Si el modelo esta creado lo podemos quitar, si la base de datos no existe la crea-->
			<property name="hibernate.hbm2ddl.auto" value="update"/> 
		</properties>
	</persistence-unit>
</persistence>